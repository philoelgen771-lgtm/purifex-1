<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>لوحة الطلبات — Purifex</title>
<meta name="robots" content="noindex, nofollow">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/@tabler/icons-webfont/3.1.0/tabler-icons.min.css">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{
  --navy:#0E1E33; --navy-2:#16304F; --ink:#12243D; --blue:#1E4D8C;
  --accent:#7A1230; --accent-d:#57091F; --accent-t:#F8ECEF;
  --paper:#F4F6F9; --white:#fff; --line:#E1E6EE; --muted:#5E6E82;
  --ok:#15A46E; --ok-t:#E7F7F0; --warn:#B8760A; --warn-t:#FCF1DD; --danger:#D14343; --danger-t:#FBEAEA;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'IBM Plex Sans Arabic',sans-serif;background:var(--paper);color:var(--ink);line-height:1.6;min-height:100vh;}
h1,h2,h3{font-family:'Cairo',sans-serif;font-weight:800;}
.num{font-variant-numeric:tabular-nums;direction:ltr;display:inline-block;}
button{font-family:inherit;cursor:pointer;}
input,select{font-family:inherit;}

/* ── LOGIN ── */
#loginWrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;}
.loginCard{width:100%;max-width:380px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:34px 28px;box-shadow:0 24px 60px -30px rgba(14,30,51,.25);}
.loginCard .lg{display:flex;align-items:center;gap:10px;font-family:'Cairo',sans-serif;font-weight:800;font-size:19px;margin-bottom:4px;}
.loginCard .lg i{color:var(--accent);font-size:24px;}
.loginCard p{color:var(--muted);font-size:13.5px;margin-bottom:22px;}
.fl{display:block;font-size:12.5px;font-weight:700;color:var(--muted);margin:0 0 6px;}
.fi{width:100%;border:1.5px solid var(--line);border-radius:10px;padding:11px 13px;font-size:14.5px;margin-bottom:16px;background:#fff;color:var(--ink);}
.fi:focus{outline:none;border-color:var(--accent);}
.btn{border:none;width:100%;border-radius:10px;padding:12px;font-weight:700;font-size:15px;background:var(--accent);color:#fff;transition:.15s;}
.btn:hover{background:var(--accent-d);}
.btn:disabled{opacity:.6;cursor:default;}
.loginErr{background:var(--danger-t);color:var(--danger);font-size:13px;border-radius:9px;padding:10px 12px;margin-bottom:14px;display:none;}
.loginErr.show{display:block;}

/* ── DASHBOARD SHELL ── */
#dash{display:none;}
#dash.on{display:block;}
header.top{background:var(--navy);color:#fff;padding:14px 0;position:sticky;top:0;z-index:20;}
.top-in{max-width:1200px;margin:0 auto;padding:0 22px;display:flex;align-items:center;justify-content:space-between;gap:14px;}
.top-in .lg{display:flex;align-items:center;gap:9px;font-family:'Cairo',sans-serif;font-weight:800;font-size:17px;}
.top-in .lg i{color:#E6B5C0;}
.logout{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2);border-radius:9px;padding:8px 14px;font-size:13px;font-weight:600;display:flex;align-items:center;gap:6px;}
.logout:hover{background:rgba(255,255,255,.18);}
.wrap{max-width:1200px;margin:0 auto;padding:26px 22px 60px;}

/* stat cards */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:26px;}
.stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 20px;}
.stat .sl{font-size:12.5px;color:var(--muted);margin-bottom:8px;}
.stat .sv{font-family:'Cairo',sans-serif;font-weight:800;font-size:24px;}
@media(max-width:900px){.stats{grid-template-columns:1fr 1fr;}}
@media(max-width:520px){.stats{grid-template-columns:1fr;}}

/* tabs + toolbar */
.tabs{display:flex;gap:8px;margin-bottom:16px;}
.tab{background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:9px 18px;font-weight:700;font-size:14px;color:var(--muted);}
.tab.on{background:var(--navy);border-color:var(--navy);color:#fff;}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px;}
.toolbar input,.toolbar select{border:1.5px solid var(--line);border-radius:9px;padding:9px 12px;font-size:13.5px;background:#fff;}
.toolbar input{flex:1;min-width:180px;}
.refreshBtn{background:#fff;border:1.5px solid var(--line);border-radius:9px;padding:9px 14px;font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:6px;color:var(--ink);}
.refreshBtn:hover{border-color:var(--accent);}

/* table / cards */
.rows{display:flex;flex-direction:column;gap:10px;}
.rowc{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 18px;cursor:pointer;}
.rowc .rtop{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
.rowc .ref{font-weight:800;font-family:'Cairo',sans-serif;color:var(--navy);}
.rowc .rname{font-size:14px;font-weight:700;}
.rowc .rmeta{font-size:12.5px;color:var(--muted);margin-top:3px;}
.rowc .rtotal{font-family:'Cairo',sans-serif;font-weight:800;font-size:16px;color:var(--accent-d);}
.badge{font-size:11.5px;font-weight:800;border-radius:20px;padding:4px 11px;white-space:nowrap;}
.badge.new{background:var(--warn-t);color:var(--warn);}
.badge.contacted{background:#E7F0FB;color:var(--blue);}
.badge.fulfilled,.badge.closed{background:var(--ok-t);color:var(--ok);}
.badge.cancelled{background:var(--danger-t);color:var(--danger);}
.rdet{display:none;margin-top:14px;padding-top:14px;border-top:1px dashed var(--line);}
.rowc.open .rdet{display:block;}
.itable{width:100%;border-collapse:collapse;font-size:13.5px;margin-bottom:12px;}
.itable th{text-align:start;color:var(--muted);font-weight:700;padding:6px 8px;border-bottom:1px solid var(--line);font-size:12px;}
.itable td{padding:6px 8px;border-bottom:1px solid #F0F2F6;}
.rctrl{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
.rctrl select{border:1.5px solid var(--line);border-radius:8px;padding:7px 10px;font-size:13px;}
.empty{text-align:center;padding:60px 20px;color:var(--muted);}
.empty i{font-size:38px;margin-bottom:10px;display:block;}
.loading{text-align:center;padding:40px;color:var(--muted);font-size:14px;}
.cfgwarn{background:var(--warn-t);color:var(--warn);border-radius:12px;padding:14px 18px;font-size:13.5px;margin-bottom:20px;display:flex;gap:10px;align-items:flex-start;}
.cfgwarn i{font-size:19px;flex:none;margin-top:1px;}
.cfgwarn code{background:rgba(0,0,0,.06);padding:1px 6px;border-radius:5px;}
</style>
</head>
<body>

<div id="loginWrap">
  <div class="loginCard">
    <div class="lg"><i class="ti ti-lock-square-rounded"></i> Purifex</div>
    <p>لوحة تحكم الطلبات — لفريق العمل فقط</p>
    <div class="loginErr" id="loginErr"></div>
    <form id="loginForm">
      <label class="fl">البريد الإلكتروني</label>
      <input class="fi" id="lEmail" type="email" required autocomplete="username">
      <label class="fl">كلمة المرور</label>
      <input class="fi" id="lPass" type="password" required autocomplete="current-password">
      <button class="btn" id="loginBtn" type="submit">تسجيل الدخول</button>
    </form>
  </div>
</div>

<div id="dash">
  <header class="top">
    <div class="top-in">
      <div class="lg"><i class="ti ti-shield-check"></i> لوحة طلبات Purifex</div>
      <button class="logout" id="logoutBtn"><i class="ti ti-logout"></i> تسجيل الخروج</button>
    </div>
  </header>
  <div class="wrap">
    <div class="stats" id="stats">
      <div class="stat"><div class="sl">طلبات اليوم</div><div class="sv num" id="stOrdersToday">—</div></div>
      <div class="stat"><div class="sl">إيراد اليوم</div><div class="sv num" id="stRevToday">—</div></div>
      <div class="stat"><div class="sl">طلبات جديدة (لم تُعالج)</div><div class="sv num" id="stNewOrders">—</div></div>
      <div class="stat"><div class="sl">طلبات عروض أسعار جديدة</div><div class="sv num" id="stNewLeads">—</div></div>
    </div>

    <div class="tabs">
      <button class="tab on" id="tabOrders" data-t="orders">طلبات التوريد</button>
      <button class="tab" id="tabLeads" data-t="leads">طلبات عروض الأسعار</button>
    </div>

    <div class="toolbar">
      <input id="searchBox" type="text" placeholder="ابحث بالاسم أو رقم الطلب أو الهاتف...">
      <select id="statusFilter"></select>
      <button class="refreshBtn" id="refreshBtn"><i class="ti ti-refresh"></i> تحديث</button>
    </div>

    <div id="listWrap"><div class="loading">جارٍ التحميل...</div></div>
  </div>
</div>

<script>
/* ══════ CONFIG — must match the values used in the main site ══════ */
const SUPABASE_URL = 'https://dsyupeuejmeehjrpvvaw.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_0tBa7gpYmUEnffarB4W0ZA_O0V_1vng';
const sb = (SUPABASE_URL.startsWith('http') && window.supabase)
  ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY)
  : null;

const $=id=>document.getElementById(id);
const EGP=n=>Number(n||0).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})+' ج.م';
const fmtDate=s=>new Date(s).toLocaleString('ar-EG',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'});

const ORDER_STATUSES=[['new','جديد'],['contacted','تم التواصل'],['fulfilled','تم التوريد'],['cancelled','ملغي']];
const LEAD_STATUSES=[['new','جديد'],['contacted','تم التواصل'],['closed','مغلق']];

let tab='orders', rows=[], openId=null;

/* ── AUTH ── */
if(!sb){
  $('loginErr').textContent='لم يتم ضبط بيانات الاتصال بقاعدة البيانات بعد (SUPABASE_URL / SUPABASE_ANON_KEY) — عدّلها في أعلى ملف admin.html.';
  $('loginErr').classList.add('show');
  $('loginBtn').disabled=true;
}
$('loginForm').onsubmit=async e=>{
  e.preventDefault();
  if(!sb) return;
  $('loginErr').classList.remove('show');
  $('loginBtn').disabled=true; $('loginBtn').textContent='جارٍ الدخول...';
  const{error}=await sb.auth.signInWithPassword({email:$('lEmail').value.trim(),password:$('lPass').value});
  $('loginBtn').disabled=false; $('loginBtn').textContent='تسجيل الدخول';
  if(error){$('loginErr').textContent='بيانات الدخول غير صحيحة. تأكد من إنشاء مستخدم Admin في Supabase Auth أولاً.';$('loginErr').classList.add('show');return;}
  showDash();
};
$('logoutBtn').onclick=async()=>{await sb.auth.signOut();location.reload();};

async function checkSession(){
  if(!sb) return;
  const{data}=await sb.auth.getSession();
  if(data.session) showDash();
}
function showDash(){
  $('loginWrap').style.display='none';
  $('dash').classList.add('on');
  loadAll();
}

/* ── TABS / TOOLBAR ── */
$('tabOrders').onclick=()=>{tab='orders';$('tabOrders').classList.add('on');$('tabLeads').classList.remove('on');buildStatusFilter();openId=null;load();};
$('tabLeads').onclick=()=>{tab='leads';$('tabLeads').classList.add('on');$('tabOrders').classList.remove('on');buildStatusFilter();openId=null;load();};
$('refreshBtn').onclick=loadAll;
$('searchBox').oninput=render;
function buildStatusFilter(){
  const list=tab==='orders'?ORDER_STATUSES:LEAD_STATUSES;
  $('statusFilter').innerHTML='<option value="">كل الحالات</option>'+list.map(([v,l])=>'<option value="'+v+'">'+l+'</option>').join('');
}
$('statusFilter').onchange=render;
buildStatusFilter();

/* ── DATA ── */
async function loadAll(){await Promise.all([load(),loadStats()]);}

async function load(){
  $('listWrap').innerHTML='<div class="loading">جارٍ التحميل...</div>';
  const{data,error}=await sb.from(tab==='orders'?'orders':'leads').select('*').order('created_at',{ascending:false}).limit(500);
  if(error){$('listWrap').innerHTML='<div class="empty"><i class="ti ti-alert-triangle"></i>تعذّر تحميل البيانات: '+error.message+'</div>';return;}
  rows=data||[];
  render();
}

async function loadStats(){
  const todayStart=new Date();todayStart.setHours(0,0,0,0);
  const[{data:ordersToday},{data:newOrders},{data:newLeads}]=await Promise.all([
    sb.from('orders').select('total').gte('created_at',todayStart.toISOString()),
    sb.from('orders').select('id',{count:'exact',head:true}).eq('status','new'),
    sb.from('leads').select('id',{count:'exact',head:true}).eq('status','new')
  ]);
  $('stOrdersToday').textContent=(ordersToday||[]).length;
  $('stRevToday').textContent=EGP((ordersToday||[]).reduce((s,o)=>s+Number(o.total||0),0));
  const{count:newOrdersCount}=await sb.from('orders').select('id',{count:'exact',head:true}).eq('status','new');
  const{count:newLeadsCount}=await sb.from('leads').select('id',{count:'exact',head:true}).eq('status','new');
  $('stNewOrders').textContent=newOrdersCount??0;
  $('stNewLeads').textContent=newLeadsCount??0;
}

/* ── RENDER ── */
function render(){
  const q=$('searchBox').value.trim().toLowerCase();
  const st=$('statusFilter').value;
  let list=rows.filter(r=>{
    if(st && r.status!==st) return false;
    if(!q) return true;
    const hay=tab==='orders'
      ? [r.ref,r.customer_name,r.phone,r.email,r.facility].join(' ').toLowerCase()
      : [r.facility,r.contact_person,r.phone,r.message].join(' ').toLowerCase();
    return hay.includes(q);
  });
  if(!list.length){$('listWrap').innerHTML='<div class="empty"><i class="ti ti-inbox"></i>لا توجد نتائج مطابقة.</div>';return;}
  $('listWrap').innerHTML='<div class="rows">'+list.map(r=>tab==='orders'?orderCard(r):leadCard(r)).join('')+'</div>';
  document.querySelectorAll('.rowc').forEach(el=>{
    el.querySelector('.rtop').onclick=()=>{
      const id=el.dataset.id;
      openId = openId===id ? null : id;
      document.querySelectorAll('.rowc').forEach(x=>x.classList.toggle('open', x.dataset.id===openId));
    };
    const sel=el.querySelector('.stSel');
    if(sel) sel.onclick=e=>e.stopPropagation();
    if(sel) sel.onchange=async()=>{
      const id=el.dataset.id, val=sel.value, table=tab==='orders'?'orders':'leads';
      sel.disabled=true;
      const{error}=await sb.from(table).update({status:val}).eq('id',id);
      sel.disabled=false;
      if(error){alert('تعذّر تحديث الحالة: '+error.message);return;}
      const row=rows.find(r=>String(r.id)===String(id)); if(row) row.status=val;
      loadStats();
      render();
      document.querySelectorAll('.rowc').forEach(x=>{if(x.dataset.id===openId)x.classList.add('open');});
    };
  });
}

function statusBadge(s,list){const l=list.find(x=>x[0]===s);return '<span class="badge '+s+'">'+(l?l[1]:s)+'</span>';}
function statusSelect(s,list){return '<select class="stSel">'+list.map(([v,l])=>'<option value="'+v+'"'+(v===s?' selected':'')+'>'+l+'</option>').join('')+'</select>';}

function orderCard(r){
  const items=Array.isArray(r.items)?r.items:[];
  return '<div class="rowc'+(openId===String(r.id)?' open':'')+'" data-id="'+r.id+'">'
   +'<div class="rtop">'
     +'<div><div class="ref num">'+r.ref+'</div><div class="rname">'+esc(r.customer_name)+'</div>'
     +'<div class="rmeta">'+fmtDate(r.created_at)+' · '+(r.phone?'<span class="num">'+esc(r.phone)+'</span> · ':'')+payLabel(r.payment_method)+'</div></div>'
     +'<div style="display:flex;align-items:center;gap:12px;">'+statusBadge(r.status,ORDER_STATUSES)+'<div class="rtotal">'+EGP(r.total)+'</div></div>'
   +'</div>'
   +'<div class="rdet">'
     +'<table class="itable"><thead><tr><th>الصنف</th><th>الوحدة</th><th>الكمية</th><th>السعر</th></tr></thead><tbody>'
     +items.map(it=>'<tr><td>'+esc(it.name)+'</td><td>'+esc(it.unit||'')+'</td><td class="num">'+it.qty+'</td><td class="num">'+EGP(it.price)+'</td></tr>').join('')
     +'</tbody></table>'
     +'<div style="font-size:13px;color:var(--muted);margin-bottom:12px;">'
       +(r.email?'البريد: '+esc(r.email)+'<br>':'')+(r.address?'العنوان: '+esc(r.address):'')
     +'</div>'
     +'<div class="rctrl"><label class="fl" style="margin:0;">الحالة:</label>'+statusSelect(r.status,ORDER_STATUSES)+'</div>'
   +'</div></div>';
}
function leadCard(r){
  return '<div class="rowc'+(openId===String(r.id)?' open':'')+'" data-id="'+r.id+'">'
   +'<div class="rtop">'
     +'<div><div class="ref num">Lead #'+r.id+'</div><div class="rname">'+esc(r.facility||'—')+'</div>'
     +'<div class="rmeta">'+fmtDate(r.created_at)+' · '+esc(r.contact_person||'')+' · <span class="num">'+esc(r.phone||'')+'</span></div></div>'
     +statusBadge(r.status,LEAD_STATUSES)
   +'</div>'
   +'<div class="rdet">'
     +'<div style="font-size:13.5px;margin-bottom:14px;white-space:pre-wrap;">'+esc(r.message||'(بدون تفاصيل إضافية)')+'</div>'
     +'<div class="rctrl"><label class="fl" style="margin:0;">الحالة:</label>'+statusSelect(r.status,LEAD_STATUSES)+'</div>'
   +'</div></div>';
}
function payLabel(m){return m==='cash'?'كاش':m==='visa'?'بطاقة':m==='apple'?'Apple Pay':(m||'');}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

checkSession();
</script>
</body>
</html>
